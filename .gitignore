# OS and editor droppings
.DS_Store
Thumbs.db
*.swp
*~

# Dependencies
node_modules/

# Build output. Regenerate with `bun run build`; server.ts answers 503 with
# instructions if it is missing.
dist/

# Local environment. A committed `.env.example` is the one file that belongs.
.env
.env.*
!.env.example

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Tool state, per clone or per machine rather than per project.
# Git hooks installed by `vp hooks enable`; a fresh clone runs that once.
/.vite-hooks/
# Agent and editor state. The installed skills under `.agents/` are fetched from
# the sources `skills-lock.json` records, so they are tooling, not source.
/.opencode/
/.commandcode/
/.freebuff/
/.agents/
/.claude/
# Python cache left by a tool that used ruff here; nothing in this repo runs it.
/.ruff_cache/
.vercel

# Local data: the dev session store is plaintext and dev-only (session-store.ts).
/.dev-sessions.json

# Captured output from a one-off debugging redirect (`… > out.txt 2>&1`). Root
# only: a real file with these names belongs somewhere in the tree.
/out*.txt
/app_*.txt
/appcheck*.txt
/*.out

# Agent scratch: captured portal responses and throwaway probe scripts. Two
# shapes stay tracked, because they are the record a feature is reviewed
# against: `<feature>/spec.md` and `<feature>/issues/*.md`. Everything else,
# including a captured folder's own notes, is scratch.
/.scratch/*
!/.scratch/*/
/.scratch/*/*
!/.scratch/*/spec.md
/.scratch/*/issues/*
!/.scratch/*/issues/*.md
