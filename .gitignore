node_modules/

# Build output. Regenerate with `bun run build`; server.ts answers 503 with
# instructions if it is missing.
dist/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Git hooks installed by `vp hooks enable`. Per-clone state: a fresh clone runs
# that once rather than inheriting this directory.
/.vite-hooks/

# Local env / editor
.env
.env.local
.DS_Store
*.log

# Captured output from a one-off debugging redirect (`… > out.txt 2>&1`).
# Root only: a real file with these names belongs somewhere in the tree.
/out*.txt
/app_*.txt
/appcheck*.txt
/*.out

# Dev session store (plaintext, dev only). See session-store.ts.
/.dev-sessions.json

# Agent scratch and tool state: probe scripts, captured portal responses, and
# session data. Not source, and not for review. The issue files and spec.md that
# live in .scratch/ stay tracked, which is why markdown is let back through.
.scratch/**
!.scratch/**/
!.scratch/**/*.md
/.opencode/
/.commandcode/

.vercel
