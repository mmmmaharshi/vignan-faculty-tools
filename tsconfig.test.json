{
  // The harness. It is Node code driving a browser, so it gets both `dom` (for
  // the page.evaluate callbacks, which run in the page) and bun-types (for
  // process.env). Unlike tsconfig.json, nothing here is ever shipped to a
  // browser, so there is no boundary to protect.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun-types"]
  },
  "include": [
    "test",
    "shared",
    "server/portal-replies.ts",
    "server/attendance-bands.ts",
    "server/portal-conventions.ts",
    "server/server-routes.ts",
    // The cascade's rules. Listed file by file rather than as "web", because
    // web/ is the DOM+React project and this harness is not - see
    // tsconfig.json. web/register/cascade.ts is deliberately free of both, which is what
    // lets the same file compile in both projects.
    "web/register/cascade.ts",
    // Pure register derivations: the panel's one absent list, and the class a
    // searched figure belongs to. Both are decisions with edges worth pinning.
    "web/register/absence-list.ts",
    "web/register/search-scope.ts",
    "web/app/panel-state.ts",
    "web/app/load-gate.ts",
    "web/app/paths.ts",
    "web/app/route-guard.ts",
    "web/app/session-view.ts",
    "web/data/sw-update.ts",
    "server/session-verdict.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}
