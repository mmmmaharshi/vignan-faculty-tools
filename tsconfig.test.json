{
  // The harness. It is Node code driving a browser, so it gets both `dom` (for
  // the page.evaluate callbacks, which run in the page) and bun-types (for
  // process.env). Unlike tsconfig.json, nothing here is ever shipped to a
  // browser, so there is no boundary to protect.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun-types"]
  },
  "include": [
    "test",
    "shared",
    "portal-replies.ts",
    "attendance-bands.ts",
    "portal-conventions.ts",
    "server-routes.ts",
    // The cascade's rules. Listed file by file rather than as "web", because
    // web/ is the DOM+React project and this harness is not - see
    // tsconfig.json. web/cascade.ts is deliberately free of both, which is what
    // lets the same file compile in both projects.
    "web/cascade.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}
